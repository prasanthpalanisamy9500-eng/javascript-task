
 // 1. forEach() - Print 5 numbers
let a1 = [10, 20, 30, 40, 50];
a1.forEach(n => console.log(n));

// 2. forEach() - Print student names
let names1 = ["Ravi", "Nisha", "Kumar"];
names1.forEach(n => console.log("Hello, " + n));

// 3. map() - Multiply by 2
let a3 = [1, 2, 3, 4, 5];
console.log(a3.map(n => n * 2));

// 4. map() - Add 100 to prices
let prices1 = [100, 200, 300];
console.log(prices1.map(p => p + 100));

// 5. filter() - Even numbers
let a5 = [1, 2, 3, 4, 5, 6];
console.log(a5.filter(n => n % 2 == 0));

// 6. filter() - Ages greater than or equal to 18
let ages = [15, 18, 20, 16, 22];
console.log(ages.filter(a => a >= 18));

// 7. find() - First number greater than 50
let a7 = [10, 30, 60, 80];
console.log(a7.find(n => n > 50));

// 8. find() - Student mark greater than 80
let students = [
    {name: "Ravi", mark: 75},
    {name: "Nisha", mark: 90},
    {name: "Kumar", mark: 85}
];
console.log(students.find(s => s.mark > 80));

// 9. reduce() - Total sum
let a9 = [10, 20, 30, 40];
console.log(a9.reduce((x, y) => x + y, 0));

// 10. reduce() - Total price
let prices2 = [100, 200, 300];
console.log(prices2.reduce((x, y) => x + y, 0));

// 11. some() - Number greater than 100
let a11 = [20, 50, 150, 80];
console.log(a11.some(n => n > 100));

// 12. every() - All marks above 35
let marks = [40, 50, 60, 70];
console.log(marks.every(m => m > 35));

// 13. Sort in ascending order
let a13 = [50, 10, 40, 20, 30];
a13.sort((x, y) => x - y);
console.log(a13);

// 14. Sort in descending order
let a14 = [50, 10, 40, 20, 30];
a14.sort((x, y) => y - x);
console.log(a14);

// 15. toString()
let names2 = ["Ravi", "Nisha", "Kumar"];
console.log(names2.toString());

// 16. join() - Combine names
let names3 = ["Ravi", "Nisha", "Kumar"];
console.log(names3.join(" - "));

// 17. join() - Products
let products = ["Pen", "Book", "Pencil"];
console.log(products.join(", "));

// 18. charAt()
let s18 = "JavaScript";
console.log(s18.charAt(4));

// 19. charCodeAt()
let s19 = "Hello";
console.log(s19.charCodeAt(0));

// 20. String length
let s20 = "Hello JavaScript";
console.log(s20.length);

// 21. slice()
let s21 = "JavaScript Developer";
console.log(s21.slice(0, 10));

// 22. toUpperCase()
let s22 = "hello world";
console.log(s22.toUpperCase());

// 23. toLowerCase()
let s23 = "HELLO WORLD";
console.log(s23.toLowerCase());

// 24. trim()
let s24 = "  Hello World  ";
console.log(s24.trim());

// 25. String methods using prompt()
let s25 = prompt("Enter a sentence");
console.log(s25.includes("Hello"));
console.log(s25.indexOf("Hello"));
console.log(s25.startsWith("Hello"));
console.log(s25.endsWith("!"));

// 26. Current year, month, date and day
let d26 = new Date();
console.log("Year:", d26.getFullYear());
console.log("Month:", d26.getMonth() + 1);
console.log("Date:", d26.getDate());
console.log("Day:", d26.getDay());

// 27. Current hours, minutes and seconds
let d27 = new Date();
console.log("Hours:", d27.getHours());
console.log("Minutes:", d27.getMinutes());
console.log("Seconds:", d27.getSeconds());

// 28. Change year using setFullYear()
let d28 = new Date();
d28.setFullYear(2025);
console.log(d28);

// 29. Change month and date
let d29 = new Date();
d29.setMonth(5);
d29.setDate(15);
console.log(d29);

// 30. Find the day of birth
let dob = prompt("Enter DOB (YYYY-MM-DD)");
let birthDate = new Date(dob);
let days = ["Sunday", "Monday", "Tuesday", "Wednesday",
            "Thursday", "Friday", "Saturday"];

if (!isNaN(birthDate.getTime())) {
    console.log("Birth Day:", days[birthDate.getDay()]);
} else {
    console.log("Invalid Date");
}
